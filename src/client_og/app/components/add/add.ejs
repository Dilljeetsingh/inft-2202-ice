<div class="content">
    <h1 class="text-center">Here You Can Add Your Details</h1>
    <p class="text-center">We're glad to have you here. Please enter your details to get more information</p>
    
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-md-6">
          <form id="animalForm">
            <div class="form-group mb-3">
              <label for="name">Animal Name</label>
              <input type="text" id="name" name="name" class="form-control">
              <p class="text-danger d-none" id="nameError">You must name this animal</p>
            </div>
            <div class="form-group mb-3">
              <label for="breed">Breed</label>
              <input type="text" id="breed" name="breed" class="form-control">
              <p class="text-danger d-none" id="breedError">You must specify the breed of this animal</p>
            </div>
            <div class="form-group mb-3">
              <label for="legs">Number of Legs</label>
              <input type="number" id="legs" name="legs" class="form-control">
              <p class="text-danger d-none" id="legsError">You must specify how many legs this animal has</p>
            </div>
            <div class="form-group mb-3">
              <label for="eyes">Number of Eyes</label>
              <input type="number" id="eyes" name="eyes" class="form-control">
              <p class="text-danger d-none" id="eyesError">You must specify how many eyes this animal has</p>
            </div>
            <div class="form-group mb-3">
              <label for="sound">Sound</label>
              <input type="text" id="sound" name="sound" class="form-control">
              <p class="text-danger d-none" id="soundError">You must specify what sound this animal makes</p>
            </div>
            <div class="form-group mb-3">
              <p class="text-danger d-none" id="duplicateError">An animal with this name already exists</p>
            </div>
            <button type="submit" class="btn btn-primary w-100">Add Animal</button>
          </form>
        </div>
      </div>
    </div>
</div>
